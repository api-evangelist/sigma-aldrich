{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sigma-Aldrich Product Search Pricing and Availability Structures API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Structures",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search by Chemical Structure",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sigmaaldrich.com/v1/structures/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Search for products by chemical structure using SMILES or InChI notation. Supports exact match, substructure search, and similarity search modes. Returns products containing or matching the specified chemical structure."
        }
      ]
    }
  ],
  "bundled": true
}