          "name": "Get Safety Data Sheet",
          "request": {
            "name": "Get Safety Data Sheet",
            "description": {
              "content": "Returns the GHS-compliant Safety Data Sheet for a specific product. SDSs are available in multiple languages and can be returned as JSON metadata or a PDF document URL for download.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "products",
                ":catalogNumber",
                "sds"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "language",
                  "value": "en-US",
                  "description": "Language code for the SDS (e.g., en-US, de-DE, fr-FR, zh-CN)"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "json",
                  "description": "Response format — structured JSON or PDF download URL"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "catalogNumber",
                  "description": "(Required) Sigma-Aldrich catalog number (e.g., A1048, M8159, CAS1234-56-7)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
