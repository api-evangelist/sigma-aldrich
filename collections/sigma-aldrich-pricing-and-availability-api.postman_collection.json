      "item": [
        {
          "id": "2f53bb25-b706-4a72-ae24-166106de52e1",
          "name": "Get Product Pricing and Availability",
          "request": {
            "name": "Get Product Pricing and Availability",
            "description": {
              "content": "Returns current pricing and real-time stock availability for all packaging sizes of a product in the specified country/region.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "products",
                ":catalogNumber",
                "pricing"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "country",
                  "value": "US",
                  "description": "ISO 3166-1 alpha-2 country code for regional pricing"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "catalogNumber",
                  "description": "(Required) Sigma-Aldrich catalog number (e.g., A1048, M8159, CAS1234-56-7)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
